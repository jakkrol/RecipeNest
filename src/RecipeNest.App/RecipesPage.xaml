<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeNest.RecipesPage"
             xmlns:vm="clr-namespace:RecipeNest.ViewModels"
             xmlns:models="clr-namespace:RecipeNest.Models"
             x:DataType="vm:RecipeViewModel"
             x:Name="RecipesPageContext">
    <Grid RowDefinitions="Auto, *" Padding="20" MaximumWidthRequest="1000">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="🍽️ My Recipes"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <SearchBar Placeholder="Search recipes..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding PerformSearchCommand}"
                           HorizontalOptions="Center"
                           WidthRequest="250"/>
                <Button Text="➕"
                        Clicked="AddRecipe_Clicked"
                        HorizontalOptions="Center"
                        WidthRequest="50"/>
            </HorizontalStackLayout>
            
            <!-- ORDER BY -->
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <Picker x:Name="picker"
                    Title="Select order"
                    SelectedItem="{Binding Order}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Desc</x:String>
                            <x:String>Asc</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </HorizontalStackLayout>
            <!-- ORDER BY -->
        </VerticalStackLayout>

        <CollectionView x:Name="MyCollection" Grid.Row="1"
                ItemsSource="{Binding FilteredRecipes}"
                SelectionMode="Single"
                SelectionChanged="CollectionView_SelectionChanged"
                Margin="15"
                VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Recipe">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Stroke="#056"
                                StrokeThickness="1"
                                BackgroundColor="#024e4b"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="8,6"
                                Shadow="5,5,15,#00000044">
                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Button Text="✏️" Clicked="Update_Clicked" />
                                    <Button Text="🗑️"
                                            Command="{Binding BindingContext.DeleteRecipeCommand, Source={x:Reference RecipesPageContext}}"
                                            CommandParameter="{Binding .}"/>
                                    <CheckBox IsChecked="{Binding IsFavourite}" CheckedChanged="CheckBox_CheckedChanged" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
