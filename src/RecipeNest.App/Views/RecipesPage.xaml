<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeNest.RecipesPage"
             xmlns:vm="clr-namespace:RecipeNest.ViewModels"
             xmlns:models="clr-namespace:RecipeNest.Models"
             x:DataType="vm:RecipeViewModel"
             x:Name="RecipesPageContext">
    <Grid RowDefinitions="Auto, *" Padding="20" MaximumWidthRequest="1000">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="🍽️ My Recipes"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="10"/>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0, 0, 10, 0">
                <SearchBar Placeholder="Search recipes..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding PerformSearchCommand}"
                           HorizontalOptions="Center"
                           WidthRequest="250"/>
                <Button Text="➕"
                        Clicked="AddRecipe_Clicked"
                        HorizontalOptions="Center"
                        WidthRequest="50"/>
            </HorizontalStackLayout>
            
            <!-- ORDER BY -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,10">
                <Label Text="Sort by:" VerticalOptions="Center" TextColor="WhiteSmoke" Opacity="0.8" />

                <HorizontalStackLayout Spacing="0">
                    <Border Stroke="#056" 
                            StrokeThickness="1" 
                            BackgroundColor="#013a38"
                            HeightRequest="40">     
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Order}" Value="Desc">
                                <Setter Property="BackgroundColor" Value="#00bfa5" />
                                <Setter Property="Stroke" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Button Text="DESC" 
                                Command="{Binding SetOrderCommand}" 
                                CommandParameter="Desc"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                Padding="15,0" />
                    </Border>

                    <Border Stroke="#056" 
                            StrokeThickness="1" 
                            BackgroundColor="#013a38"
                            HeightRequest="40"
                            Margin="-1,0,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Order}" Value="Asc">
                                <Setter Property="BackgroundColor" Value="#00bfa5" />
                                <Setter Property="Stroke" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Button Text="ASC" 
                                Command="{Binding SetOrderCommand}" 
                                CommandParameter="Asc"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                Padding="15,0" />
                    </Border>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
            <!-- ORDER BY -->
        </VerticalStackLayout>

        <CollectionView x:Name="MyCollection" Grid.Row="1"
                        ItemsSource="{Binding FilteredRecipes}"
                        SelectionMode="Single"
                        SelectionChanged="CollectionView_SelectionChanged"
                        Margin="15"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Recipe">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border Stroke="#056"
                                StrokeThickness="1"
                                BackgroundColor="#024e4b"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="8,6"
                                Shadow="5,5,15,#00000044">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>

                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Button Text="✏️" Clicked="Update_Clicked" BackgroundColor="Transparent" />
                                    <Button Text="🗑️"
                                            Command="{Binding BindingContext.DeleteRecipeCommand, Source={x:Reference RecipesPageContext}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"/>
                                    <CheckBox IsChecked="{Binding IsFavourite}" CheckedChanged="CheckBox_CheckedChanged" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
