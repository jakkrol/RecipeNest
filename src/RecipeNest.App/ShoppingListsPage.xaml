<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeNest.ShoppingListsPage"
             xmlns:vm="clr-namespace:RecipeNest.ViewModels"
             xmlns:models="clr-namespace:RecipeNest.Models"
             x:DataType="vm:ShoppingListViewModel"
             x:Name="ListPageContext">
    <Grid RowDefinitions="Auto, *" Padding="20" MaximumWidthRequest="1000">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="My Shopping Lists"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <HorizontalStackLayout HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="10">
                <SearchBar Placeholder="Search recipes..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding PerformSearchCommand}"
                           HorizontalOptions="Center"
                           WidthRequest="250"/>
                <Button x:Name="AddList"
                        Text="➕"
                        Clicked="AddList_Clicked"
                        HorizontalOptions="Center"
                        WidthRequest="50"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="MyCollection"
                Grid.Row="1"
                ItemsSource="{Binding FilteredShoppingLists}"
                SelectionMode="Single"
                SelectionChanged="MyCollection_SelectionChanged"
                Margin="15"
                VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ShoppingList">
                    <Border Stroke="#056"
                    StrokeThickness="1"
                    BackgroundColor="#024e4b"
                    StrokeShape="RoundRectangle 20"
                    Padding="16"
                    Shadow="5,5,15,#00000044">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#024e4b" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8" HorizontalOptions="End">
                                <Button Text="✏️" Clicked="Update_Clicked"/>
                                <Button Text="🗑️"
                                Command="{Binding BindingContext.DeleteListCommand, Source={x:Reference ListPageContext}}"
                                CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                 Progress="{Binding ListProgress}"
                                 HeightRequest="6"
                                 Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
