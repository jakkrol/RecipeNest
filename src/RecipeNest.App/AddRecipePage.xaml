<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeNest.AddRecipePage"
             xmlns:vm="clr-namespace:RecipeNest.ViewModels"
             x:DataType="vm:AddRecipeViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="2">
                <Label Text="Recipe Name" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Entry Text="{Binding Name}" Placeholder="e.g., Spaghetti Carbonara" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Category" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Entry Text="{Binding Category}" Placeholder="e.g., Italian" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Description" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Editor Text="{Binding Description}" 
                Placeholder="Short description..." 
                AutoSize="TextChanges" 
                MinimumHeightRequest="80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Ingredients" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Editor Text="{Binding Ingredients}" 
                Placeholder="e.g., pasta, eggs, cheese" 
                AutoSize="TextChanges" 
                MinimumHeightRequest="80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Instructions" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Editor Text="{Binding Instructions}" 
                Placeholder="How to make it..." 
                AutoSize="TextChanges" 
                MinimumHeightRequest="120" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="2">
                <Label Text="Image URL (optional)" FontAttributes="Bold" TextColor="WhiteSmoke" />
                <Entry Text="{Binding ImageUrl}" Placeholder="http://..." />
            </VerticalStackLayout>

            <Button Text="Add Recipe" 
            Command="{Binding SaveRecipeCommand}" 
            Margin="0,10,0,0"
            CornerRadius="10"
            HeightRequest="50"
            BackgroundColor="#00bfa5" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
